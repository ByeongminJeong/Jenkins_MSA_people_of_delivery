pipeline {
    agent any
    
    environment {
        // Git 커밋 해시를 포함한 의미있는 태그 생성
        GIT_COMMIT_SHORT = sh(
            script: 'git rev-parse --short=7 HEAD',
            returnStdout: true
        ).trim()

        // 브랜치명 정리 및 안전한 태그 생성 (Jenkins 환경변수 우선 사용)
        BRANCH_NAME_CLEAN = sh(
            script: '''
                # 디버그 메시지는 stderr로 출력
                echo "DEBUG - BRANCH_NAME: ${BRANCH_NAME:-empty}" >&2
                echo "DEBUG - GIT_BRANCH: ${GIT_BRANCH:-empty}" >&2
                echo "DEBUG - CHANGE_BRANCH: ${CHANGE_BRANCH:-empty}" >&2
                echo "DEBUG - Current HEAD: $(git rev-parse --short HEAD)" >&2
                echo "DEBUG - Current branch: $(git branch --show-current || echo 'detached')" >&2

                # Jenkins 환경변수들 중에서 브랜치명 찾기
                if [ -n "${CHANGE_BRANCH:-}" ]; then
                    CURRENT_BRANCH="${CHANGE_BRANCH}"
                    echo "DEBUG - Using CHANGE_BRANCH: $CURRENT_BRANCH" >&2
                elif [ -n "${GIT_BRANCH:-}" ]; then
                    CURRENT_BRANCH="${GIT_BRANCH}"
                    echo "DEBUG - Using GIT_BRANCH: $CURRENT_BRANCH" >&2
                elif [ -n "${BRANCH_NAME:-}" ]; then
                    CURRENT_BRANCH="${BRANCH_NAME}"
                    echo "DEBUG - Using BRANCH_NAME: $CURRENT_BRANCH" >&2
                else
                    # Git에서 직접 브랜치명 가져오기 (detached HEAD 상태 고려)
                    CURRENT_BRANCH=$$(git symbolic-ref --short HEAD 2>/dev/null || git describe --tags --exact-match 2>/dev/null || echo "detached-$$(git rev-parse --short HEAD)")
                    echo "DEBUG - Using git command: $CURRENT_BRANCH" >&2
                fi

                echo "DEBUG - Selected branch: $CURRENT_BRANCH" >&2

                # origin/ 접두사 제거 및 특수문자 처리
                CLEAN_BRANCH=$$(echo "$$CURRENT_BRANCH" | sed 's|^origin/||' | sed 's|^refs/heads/||' | sed 's/[^a-zA-Z0-9]/-/g' | sed 's/^-*//' | sed 's/-*$//')

                # 빈 값이거나 detached 상태면 현재 커밋 해시 사용 (POSIX 호환 문법 사용)
                if [ -z "$CLEAN_BRANCH" ]; then
                    CLEAN_BRANCH="commit-$(git rev-parse --short HEAD)"
                else
                    case "$CLEAN_BRANCH" in
                        detached*)
                            CLEAN_BRANCH="commit-$(git rev-parse --short HEAD)"
                            ;;
                    esac
                fi

                echo "DEBUG - Final clean branch: $CLEAN_BRANCH" >&2
                # 실제 결과값만 stdout으로 출력
                echo "$CLEAN_BRANCH"
            ''',
            returnStdout: true
        ).trim()

        // 안전한 이미지 태그 생성: 브랜치명-커밋해시
        IMAGE_TAG = sh(
            script: '''
                CLEAN_BRANCH="${BRANCH_NAME_CLEAN}"
                COMMIT_SHORT="${GIT_COMMIT_SHORT}"

                # 디버그 메시지는 stderr로 출력
                echo "DEBUG - Building tag with CLEAN_BRANCH: '$$CLEAN_BRANCH', COMMIT_SHORT: '$$COMMIT_SHORT'" >&2

                # 브랜치명과 커밋해시 모두 있는지 확인
                if [ -n "$$CLEAN_BRANCH" ] && [ -n "$$COMMIT_SHORT" ]; then
                    TAG="$${CLEAN_BRANCH}-$${COMMIT_SHORT}"
                else
                    echo "ERROR: 브랜치명 또는 커밋해시를 가져올 수 없습니다" >&2
                    echo "CLEAN_BRANCH: '$CLEAN_BRANCH'" >&2
                    echo "COMMIT_SHORT: '$COMMIT_SHORT'" >&2

                    # 폴백: 현재 커밋 해시만 사용
                    FALLBACK_COMMIT=$(git rev-parse --short=7 HEAD)
                    TAG="build-$${BUILD_NUMBER}-$${FALLBACK_COMMIT}"
                    echo "FALLBACK TAG: $TAG" >&2
                fi

                # 태그가 하이픈으로 시작하지 않도록 보장
                FINAL_TAG=$$(echo "$$TAG" | sed 's/^-*//')
                echo "DEBUG - Final tag: $FINAL_TAG" >&2
                # 실제 결과값만 stdout으로 출력
                echo "$FINAL_TAG"
            ''',
            returnStdout: true
        ).trim()
    }

    stages {
        stage('Checkout') {
            steps {
                echo "코드 체크아웃 중..."
                echo "브랜치: ${BRANCH_NAME_CLEAN}"
                echo "커밋: ${GIT_COMMIT_SHORT}"
                echo "이미지 태그: ${IMAGE_TAG}"
                checkout scm
            }
        }

        stage('Load Configuration') {
            steps {
                echo "환경 설정 로드 중..."
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        echo "설정 파일 로드 완료: $CONFIG_FILE"
                        . $CONFIG_FILE

                        echo "AWS Region: $AWS_REGION"
                        echo "AWS Account ID: $AWS_ACCOUNT_ID"
                        echo "ECR Prefix: $ECR_PREFIX"
                        echo "Image Tag: ${IMAGE_TAG}"

                        /usr/local/bin/aws configure set aws_access_key_id $AWS_ACCESS_KEY_ID
                        /usr/local/bin/aws configure set aws_secret_access_key $AWS_SECRET_ACCESS_KEY
                        /usr/local/bin/aws configure set default.region $AWS_REGION

                        echo "AWS 설정 완료"
                        /usr/local/bin/aws sts get-caller-identity
                    '''
                }
            }
        }

        stage('Start Docker Daemon') {
            steps {
                echo "Docker 데몬 시작 중..."
                sh '''
                    # 기존 Docker 프로세스 정리
                    pkill -f dockerd || true
                    sleep 5

                    # Docker 데몬 시작
                    dockerd --host=unix:///var/run/docker.sock --host=tcp://0.0.0.0:2376 &

                    echo "Docker 데몬 시작 대기 중..."
                    sleep 30

                    # Docker 상태 확인
                    for i in {1..10}; do
                        if docker version >/dev/null 2>&1; then
                            echo "Docker 데몬 연결 성공!"
                            break
                        else
                            echo "Docker 데몬 연결 시도 $i/10..."
                            sleep 5
                        fi
                    done

                    docker version
                    echo "Docker 데몬 시작 완료"
                '''
            }
        }

        stage('ECR Login') {
            steps {
                echo "ECR 로그인 중..."
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        . $CONFIG_FILE

                        export ECR_REGISTRY=$${AWS_ACCOUNT_ID}.dkr.ecr.$${AWS_REGION}.amazonaws.com
                        echo "ECR Registry: $ECR_REGISTRY"

                        /usr/local/bin/aws ecr get-login-password --region $$AWS_REGION | docker login --username AWS --password-stdin $$ECR_REGISTRY
                        echo "ECR 로그인 성공"
                    '''
                }
            }
        }

        stage('Build and Push Auth Service') {
            steps {
                echo "Auth Service 빌드 중..."
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        . $CONFIG_FILE
                        export ECR_REGISTRY=$${AWS_ACCOUNT_ID}.dkr.ecr.$${AWS_REGION}.amazonaws.com
                        export IMAGE_TAG_VAR="'''+IMAGE_TAG+'''"

                        echo "=== Auth Service 빌드 시작 ==="
                        echo "브랜치: ${BRANCH_NAME_CLEAN}"
                        echo "기본 태그: ${IMAGE_TAG_VAR}"
                        echo "ECR_REGISTRY: ${ECR_REGISTRY}"

                        cd "${WORKSPACE}"

                        if [ -f "./gradlew" ]; then
                            chmod +x ./gradlew
                            echo "Auth Service Gradle 빌드..."
                            ./gradlew :auth-service:clean :auth-service:build -x test --no-daemon --stacktrace

                            echo "Auth Service Docker 이미지 빌드..."
                            docker build -f ./auth-service/Dockerfile \
                                -t $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:${IMAGE_TAG_VAR} .

                            echo "Auth Service ECR 푸시..."
                            docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:${IMAGE_TAG_VAR}

                            # 브랜치별 추가 태그 전략
                            echo "브랜치별 태그 전략 적용: ${BRANCH_NAME_CLEAN}"
                            case "${BRANCH_NAME_CLEAN}" in
                                main|master)
                                    echo "메인 브랜치 - latest 태그 추가"
                                    docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:${IMAGE_TAG_VAR} \
                                        $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:latest
                                    docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:latest

                                    # 카나리 준비용 태그
                                    docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:${IMAGE_TAG_VAR} \
                                        $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:canary-ready
                                    docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:canary-ready
                                    ;;
                                jenkins-canary|canary|*canary*)
                                    echo "카나리 브랜치 - canary 태그 추가"
                                    docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:${IMAGE_TAG_VAR} \
                                        $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:canary
                                    docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:canary
                                    ;;
                                develop|dev)
                                    echo "개발 브랜치 - dev 태그 추가"
                                    docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:${IMAGE_TAG_VAR} \
                                        $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:dev
                                    docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/auth-service:dev
                                    ;;
                                *)
                                    echo "기타 브랜치 - 기본 태그만 사용"
                                    ;;
                            esac

                            echo "Auth Service 빌드 완료 - 태그: ${IMAGE_TAG_VAR}"
                        else
                            echo "ERROR: Gradle wrapper not found"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Build and Push User Service') {
            steps {
                echo "User Service 빌드 중..."
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        . $CONFIG_FILE
                        export ECR_REGISTRY=$${AWS_ACCOUNT_ID}.dkr.ecr.$${AWS_REGION}.amazonaws.com
                        export IMAGE_TAG_VAR="'''+IMAGE_TAG+'''"

                        echo "=== User Service 빌드 시작 ==="
                        echo "기본 태그: ${IMAGE_TAG_VAR}"

                        cd "${WORKSPACE}"

                        echo "User Service Gradle 빌드..."
                        ./gradlew :user-service:clean :user-service:build -x test --no-daemon --stacktrace

                        echo "User Service Docker 이미지 빌드..."
                        docker build -f ./user-service/Dockerfile \
                            -t $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:${IMAGE_TAG_VAR} .

                        echo "User Service ECR 푸시..."
                        docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:${IMAGE_TAG_VAR}

                        # 브랜치별 추가 태그 전략
                        case "${BRANCH_NAME_CLEAN}" in
                            main|master)
                                echo "메인 브랜치 - latest 태그 추가"
                                docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:${IMAGE_TAG_VAR} \
                                    $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:latest
                                docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:latest

                                docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:${IMAGE_TAG_VAR} \
                                    $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:canary-ready
                                docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:canary-ready
                                ;;
                            jenkins-canary|canary|*canary*)
                                echo "카나리 브랜치 - canary 태그 추가"
                                docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:${IMAGE_TAG_VAR} \
                                    $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:canary
                                docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:canary
                                ;;
                            develop|dev)
                                echo "개발 브랜치 - dev 태그 추가"
                                docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:${IMAGE_TAG_VAR} \
                                    $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:dev
                                docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/user-service:dev
                                ;;
                        esac

                        echo "User Service 빌드 완료 - 태그: ${IMAGE_TAG_VAR}"
                    '''
                }
            }
        }

        stage('Build and Push Module Common') {
            steps {
                echo "Module Common 빌드 중..."
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        . $CONFIG_FILE
                        export ECR_REGISTRY=$${AWS_ACCOUNT_ID}.dkr.ecr.$${AWS_REGION}.amazonaws.com
                        export IMAGE_TAG_VAR="'''+IMAGE_TAG+'''"

                        echo "=== Module Common 빌드 시작 ==="
                        echo "기본 태그: ${IMAGE_TAG_VAR}"

                        cd "${WORKSPACE}"

                        echo "Module Common Gradle 빌드..."
                        ./gradlew :module-common:clean :module-common:build -x test --no-daemon --stacktrace

                        echo "Module Common Docker 이미지 빌드..."
                        docker build -f ./module-common/Dockerfile \
                            -t $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:${IMAGE_TAG_VAR} .

                        echo "Module Common ECR 푸시..."
                        docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:${IMAGE_TAG_VAR}

                        # 브랜치별 추가 태그 전략
                        case "${BRANCH_NAME_CLEAN}" in
                            main|master)
                                echo "메인 브랜치 - latest 태그 추가"
                                docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:${IMAGE_TAG_VAR} \
                                    $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:latest
                                docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:latest

                                docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:${IMAGE_TAG_VAR} \
                                    $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:canary-ready
                                docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:canary-ready
                                ;;
                            jenkins-canary|canary|*canary*)
                                echo "카나리 브랜치 - canary 태그 추가"
                                docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:${IMAGE_TAG_VAR} \
                                    $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:canary
                                docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:canary
                                ;;
                            develop|dev)
                                echo "개발 브랜치 - dev 태그 추가"
                                docker tag $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:${IMAGE_TAG_VAR} \
                                    $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:dev
                                docker push $${ECR_REGISTRY}/$${ECR_PREFIX}/module-common:dev
                                ;;
                        esac

                        echo "Module Common 빌드 완료 - 태그: ${IMAGE_TAG_VAR}"
                    '''
                }
            }
        }

        stage('Canary Deployment Strategy') {
            when {
                anyOf {
                    expression { env.BRANCH_NAME_CLEAN ==~ /.*canary.*/ }
                    expression { env.BRANCH_NAME_CLEAN == 'jenkins-canary' }
                }
            }
            steps {
                echo "카나리 배포 전략 실행 중..."
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        . $CONFIG_FILE
                        export ECR_REGISTRY=$${AWS_ACCOUNT_ID}.dkr.ecr.$${AWS_REGION}.amazonaws.com
                        export DEPLOY_IMAGE_TAG="$IMAGE_TAG"

                        echo "=== 카나리 배포 시작 ==="
                        echo "카나리 이미지 태그: canary"
                        echo "원본 이미지 태그: ${DEPLOY_IMAGE_TAG}"
                        echo "브랜치: ${BRANCH_NAME_CLEAN}"

                        # 카나리 배포용 환경변수 설정
                        export CANARY_TAG="canary"
                        export STABLE_TAG="latest"

                        # app 네임스페이스 생성
                        /usr/local/bin/kubectl create namespace app --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -

                        # Argo Rollouts로 카나리 배포
                        if /usr/local/bin/kubectl get crd rollouts.argoproj.io >/dev/null 2>&1; then
                            echo "Argo Rollouts 카나리 배포 시작..."

                            # 카나리 배포 설정 적용
                            for service in auth-service user-service module-common; do
                                rollout_file="k8s/services/$$service/$$service-canary-rollout.yaml"
                                if [ -f "$rollout_file" ]; then
                                    echo "$service 카나리 Rollout 배포 중..."
                                    envsubst '$$ECR_REGISTRY $$ECR_PREFIX $$CANARY_TAG $$STABLE_TAG' < "$rollout_file" | /usr/local/bin/kubectl apply -f -
                                else
                                    echo "$service 카나리 Rollout 파일 없음, 기본 Rollout 사용"
                                    # 기존 Rollout을 카나리 이미지로 업데이트
                                    if /usr/local/bin/kubectl get rollout ${service}-rollout -n app >/dev/null 2>&1; then
                                        /usr/local/bin/kubectl patch rollout $${service}-rollout -n app -p '{"spec":{"template":{"spec":{"containers":[{"name":"'$${service}'-container","image":"'$${ECR_REGISTRY}/$${ECR_PREFIX}/${service}:canary'"}]}}}}'
                                    else
                                        echo "$service Rollout 없음 - 일반 배포로 진행"
                                    fi
                                fi
                            done

                            echo "카나리 배포 상태 확인..."
                            sleep 30
                            /usr/local/bin/kubectl get rollouts -n app || echo "Rollout 없음"

                            # 카나리 배포 자동 승격 (조건에 따라)
                            echo "카나리 배포 상태 모니터링..."
                            for i in {1..10}; do
                                echo "확인 $i/10..."
                                healthy_count=$(/usr/local/bin/kubectl get rollouts -n app -o jsonpath='{.items[*].status.phase}' 2>/dev/null | grep -o "Healthy" | wc -l || echo "0")
                                if [ "$healthy_count" -gt 0 ]; then
                                    echo "카나리 배포 안정적 ($healthy_count 개 서비스), 계속 진행"
                                    break
                                fi
                                sleep 30
                            done
                        else
                            echo "Argo Rollouts 없음 - 일반 배포로 진행"
                        fi

                        echo "카나리 배포 완료"
                    '''
                }
            }
        }

        stage('Deploy Services') {
            steps {
                echo "서비스 배포 시작"
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        . $CONFIG_FILE
                        export ECR_REGISTRY=$${AWS_ACCOUNT_ID}.dkr.ecr.$${AWS_REGION}.amazonaws.com
                        export DEPLOY_IMAGE_TAG="$IMAGE_TAG"

                        echo "배포 시작..."
                        echo "ECR Registry: $ECR_REGISTRY"
                        echo "Deploy Image Tag: $DEPLOY_IMAGE_TAG"

                        # app 네임스페이스 생성
                        /usr/local/bin/kubectl create namespace app --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -

                        echo "ConfigMap 및 Secret 생성 중..."

                        # Auth Service ConfigMap
                        /usr/local/bin/kubectl create configmap auth-service-config -n app \
                            --from-literal=db-url="$DB_URL" \
                            --from-literal=db-username="$DB_USERNAME" \
                            --from-literal=redis-host="$REDIS_HOST" \
                            --from-literal=redis-port="$REDIS_PORT" \
                            --from-literal=google-client-id="$GOOGLE_CLIENT_ID" \
                            --from-literal=mail-username="$MAIL_USERNAME" \
                            --from-literal=service-port="$AUTH_SERVICE_PORT" \
                            --from-literal=health-check-path="$AUTH_SERVICE_HEALTH_CHECK_PATH" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -

                        # Auth Service Secret
                        /usr/local/bin/kubectl create secret generic auth-service-secrets -n app \
                            --from-literal=db-password="$DB_PASSWORD" \
                            --from-literal=google-client-secret-id="$GOOGLE_CLIENT_SECRET_ID" \
                            --from-literal=mail-password="$MAIL_PASSWORD" \
                            --from-literal=jwt-secret="$JWT_SECRET" \
                            --from-literal=jwt-refresh-secret="$JWT_REFRESH_SECRET" \
                            --from-literal=passport-secret="$AUTH_SERVICE_PASSPORT_SECRET" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -

                        # User Service ConfigMap
                        /usr/local/bin/kubectl create configmap user-service-config -n app \
                            --from-literal=db-url="$DB_URL" \
                            --from-literal=db-username="$DB_USERNAME" \
                            --from-literal=redis-host="$REDIS_HOST" \
                            --from-literal=redis-port="$REDIS_PORT" \
                            --from-literal=google-client-id="$GOOGLE_CLIENT_ID" \
                            --from-literal=mail-username="$MAIL_USERNAME" \
                            --from-literal=service-port="$USER_SERVICE_PORT" \
                            --from-literal=health-check-path="$USER_SERVICE_HEALTH_CHECK_PATH" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -

                        # User Service Secret
                        /usr/local/bin/kubectl create secret generic user-service-secrets -n app \
                            --from-literal=db-password="$DB_PASSWORD" \
                            --from-literal=google-client-secret-id="$GOOGLE_CLIENT_SECRET_ID" \
                            --from-literal=mail-password="$MAIL_PASSWORD" \
                            --from-literal=jwt-secret="$JWT_SECRET" \
                            --from-literal=jwt-refresh-secret="$JWT_REFRESH_SECRET" \
                            --from-literal=passport-secret="$USER_SERVICE_PASSPORT_SECRET" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -

                        # Module Common ConfigMap
                        /usr/local/bin/kubectl create configmap module-common-config -n app \
                            --from-literal=db-url="$DB_URL" \
                            --from-literal=db-username="$DB_USERNAME" \
                            --from-literal=service-port="$MODULE_COMMON_SERVICE_PORT" \
                            --from-literal=health-check-path="$MODULE_COMMON_SERVICE_HEALTH_CHECK_PATH" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -

                        # Module Common Secret
                        /usr/local/bin/kubectl create secret generic module-common-secrets -n app \
                            --from-literal=db-password="$DB_PASSWORD" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -

                        echo "ConfigMap 및 Secret 생성 완료"

                        # Argo Rollouts 배포 확인
                        if /usr/local/bin/kubectl get crd rollouts.argoproj.io >/dev/null 2>&1; then
                            echo "Argo Rollouts 배포 시작..."

                            # 환경변수 export - 실제 빌드된 태그 사용
                            export ECR_REGISTRY="$ECR_REGISTRY"
                            export ECR_PREFIX="$ECR_PREFIX"
                            export IMAGE_TAG="$DEPLOY_IMAGE_TAG"

                            echo "환경변수 확인:"
                            echo "ECR_REGISTRY: $ECR_REGISTRY"
                            echo "ECR_PREFIX: $ECR_PREFIX"
                            echo "IMAGE_TAG: $IMAGE_TAG (빌드된 특정 태그)"

                            # 브랜치별 배포 전략
                            case "${BRANCH_NAME_CLEAN}" in
                                jenkins-canary|canary|*canary*)
                                    echo "카나리 브랜치 배포 - canary 태그 사용"
                                    export IMAGE_TAG="canary"
                                    ;;
                                main|master)
                                    echo "메인 브랜치 배포 - latest 태그 사용"
                                    export IMAGE_TAG="latest"
                                    ;;
                                develop|dev)
                                    echo "개발 브랜치 배포 - dev 태그 사용"
                                    export IMAGE_TAG="dev"
                                    ;;
                                *)
                                    echo "기타 브랜치 배포 - 특정 태그 사용: $DEPLOY_IMAGE_TAG"
                                    export IMAGE_TAG="$DEPLOY_IMAGE_TAG"
                                    ;;
                            esac

                            # Rollout 파일들 배포
                            for service in auth-service user-service module-common; do
                                rollout_file="k8s/services/$$service/$$service-rollout.yaml"
                                if [ -f "$rollout_file" ]; then
                                    echo "$service Rollout 배포 중..."
                                    echo "파일 위치: $rollout_file"
                                    echo "사용할 이미지 태그: $IMAGE_TAG"
                                    envsubst '$$ECR_REGISTRY $$ECR_PREFIX $$IMAGE_TAG' < "$$rollout_file" | /usr/local/bin/kubectl apply -f -
                                    echo "$service Rollout 배포 완료"
                                else
                                    echo "$$service Rollout 파일 없음: $$rollout_file"
                                    echo "사용 가능한 파일들:"
                                    find k8s -name "*rollout*" -type f 2>/dev/null || echo "rollout 파일 없음"
                                fi
                            done

                            # Rollout 상태 확인
                            echo "Rollout 상태 확인 중..."
                            sleep 10
                            /usr/local/bin/kubectl get rollouts -n app || echo "Rollout 리소스 없음"
                        else
                            echo "Argo Rollouts CRD 없음 - Controller 설치 필요"
                            echo "사용 가능한 CRD 확인:"
                            /usr/local/bin/kubectl get crd | grep -i rollout || echo "rollout CRD 없음"
                        fi

                        echo "배포 완료"
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                echo "배포 상태 확인 중..."
                sh '''
                    echo "=== 배포 상태 확인 ==="
                    /usr/local/bin/kubectl get all -n app

                    echo "=== ConfigMap 및 Secret 확인 ==="
                    /usr/local/bin/kubectl get configmaps,secrets -n app

                    echo "=== Rollout 확인 ==="
                    if /usr/local/bin/kubectl get crd rollouts.argoproj.io >/dev/null 2>&1; then
                        /usr/local/bin/kubectl get rollouts -n app || echo "Rollout 리소스 없음"

                        # 개별 Rollout 상태 확인
                        for rollout in auth-service-rollout user-service-rollout module-common-rollout; do
                            if /usr/local/bin/kubectl get rollout $rollout -n app >/dev/null 2>&1; then
                                echo "=== $rollout 상태 ==="
                                /usr/local/bin/kubectl describe rollout $rollout -n app
                            fi
                        done
                    else
                        echo "Argo Rollouts CRD 없음"
                    fi

                    echo "=== Pod 상태 상세 확인 ==="
                    /usr/local/bin/kubectl get pods -n app -o wide

                    echo "=== 실행 중인 이미지 확인 ==="
                    /usr/local/bin/kubectl get pods -n app -o jsonpath="{.items[*].spec.containers[*].image}" | tr " " "\\n" | sort | uniq

                    echo "=== 이벤트 확인 ==="
                    /usr/local/bin/kubectl get events -n app --sort-by='.lastTimestamp' | tail -20 || echo "이벤트 없음"

                    echo "=== 서비스 헬스체크 ==="
                    for service in auth-service user-service module-common; do
                        pod_name=$(/usr/local/bin/kubectl get pods -n app -l app=${service} -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
                        if [ -n "$pod_name" ]; then
                            echo "=== $service 헬스체크 ==="
                            /usr/local/bin/kubectl exec -n app $pod_name -- curl -f http://localhost:8080/actuator/health 2>/dev/null || echo "$service 헬스체크 실패"
                        fi
                    done

                    echo "=== 배포 확인 완료 ==="
                '''
            }
        }

                stage('Tag latest after Promotion') {
                    when {
                        anyOf {
                            branch 'main'
                            branch 'master'
                            expression { env.BRANCH_NAME_CLEAN ==~ /.*canary.*/ }
                        }
                    }
                    steps {
                        echo "프로모션 성공 시 latest 태그로 반영"
                        configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                            sh '''
                                . $CONFIG_FILE
                                export ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                                promote_and_tag() {
                                    svc="$1"
                                    image_path="${ECR_REGISTRY}/${ECR_PREFIX}/${svc}"

                                    echo "=== ${svc} 프로모션 상태 확인 ==="

                                    # Rollout 상태 정확히 체크
                                    rollout_status=$(/usr/local/bin/kubectl get rollout ${svc}-rollout -n app -o jsonpath='{.status.phase}' 2>/dev/null || echo "NotFound")

                                    if [ "$rollout_status" = "Healthy" ]; then
                                        echo "${svc} 프로모션 완료 확인됨"

                                        # 브랜치별 태깅 전략
                                        case "${BRANCH_NAME_CLEAN}" in
                                            main|master)
                                                echo "${svc} 메인 브랜치 - latest 태그 업데이트"
                                                if docker pull ${image_path}:${IMAGE_TAG} 2>/dev/null; then
                                                    docker tag ${image_path}:${IMAGE_TAG} ${image_path}:latest
                                                    docker push ${image_path}:latest
                                                    echo "${svc} latest 태그 업데이트 완료"
                                                else
                                                    echo "${svc} 이미지 pull 실패"
                                                fi
                                                ;;
                                            jenkins-canary|canary|*canary*)
                                                echo "${svc} 카나리 성공 - canary-stable 태그 생성"
                                                if docker pull ${image_path}:${IMAGE_TAG} 2>/dev/null; then
                                                    docker tag ${image_path}:${IMAGE_TAG} ${image_path}:canary-stable
                                                    docker push ${image_path}:canary-stable
                                                    echo "${svc} canary-stable 태그 생성 완료"

                                                    # 카나리 성공 시 자동으로 latest 승격 (선택사항)
                                                    echo "${svc} 카나리 성공 - latest로 자동 승격"
                                                    docker tag ${image_path}:${IMAGE_TAG} ${image_path}:latest
                                                    docker push ${image_path}:latest
                                                    echo "${svc} latest로 승격 완료"
                                                else
                                                    echo "${svc} 이미지 pull 실패"
                                                fi
                                                ;;
                                        esac

                                        echo "${svc} 태깅 완료"
                                    elif [ "$rollout_status" = "Progressing" ]; then
                                        echo "${svc} 아직 진행 중 (Progressing). 태깅 스킵"
                                    elif [ "$rollout_status" = "Paused" ]; then
                                        echo "${svc} 일시정지 상태 (Paused). 태깅 스킵"
                                    elif [ "$rollout_status" = "Degraded" ]; then
                                        echo "${svc} 성능 저하 상태 (Degraded). 태깅 스킵"
                                    else
                                        echo "${svc} 상태: $rollout_status. 태깅 스킵"
                                    fi
                                }

                                echo "프로모션 상태 확인 시작..."
                                echo "현재 브랜치: ${BRANCH_NAME_CLEAN}"
                                echo "현재 이미지 태그: ${IMAGE_TAG}"

                                promote_and_tag auth-service
                                promote_and_tag user-service
                                promote_and_tag module-common

                                echo "=== 최종 태그 상태 ==="
                                for service in auth-service user-service module-common; do
                                    echo "=== $service 태그 목록 ==="
                                    /usr/local/bin/aws ecr describe-images --repository-name ${ECR_PREFIX}/$service --region ${AWS_REGION} --query 'imageDetails[*].imageTags' --output table 2>/dev/null | head -20 || echo "$service 태그 조회 실패"
                                done

                                echo "프로모션 확인 완료"
                            '''
                        }
                    }
                }
            }

            post {
                success {
                    echo "전체 파이프라인 성공!"
                    sh '''
                        echo "=== 최종 배포 결과 ==="
                        echo "브랜치: ${BRANCH_NAME_CLEAN}"
                        echo "이미지 태그: ${IMAGE_TAG}"
                        echo ""

                        echo "=== 실행 중인 Pod 상태 ==="
                        /usr/local/bin/kubectl get pods -n app -o wide

                        echo "=== 사용된 이미지 확인 ==="
                        /usr/local/bin/kubectl get pods -n app -o jsonpath="{.items[*].spec.containers[*].image}" | tr " " "\\n" | sort | uniq

                        echo "=== Rollout 최종 상태 ==="
                        /usr/local/bin/kubectl get rollouts -n app -o wide || echo "Rollout 없음"

                        echo "=== 서비스 상태 ==="
                        /usr/local/bin/kubectl get services -n app || echo "서비스 없음"

                        echo "=== 성공적으로 배포된 태그 정보 ==="
                        case "${BRANCH_NAME_CLEAN}" in
                            main|master)
                                echo "✅ 메인 브랜치 배포 완료"
                                echo "   - 기본 태그: ${IMAGE_TAG}"
                                echo "   - 프로덕션 태그: latest"
                                echo "   - 카나리 준비: canary-ready"
                                ;;
                            jenkins-canary|canary|*canary*)
                                echo "✅ 카나리 브랜치 배포 완료"
                                echo "   - 기본 태그: ${IMAGE_TAG}"
                                echo "   - 카나리 태그: canary"
                                echo "   - 안정화 태그: canary-stable"
                                ;;
                            develop|dev)
                                echo "✅ 개발 브랜치 배포 완료"
                                echo "   - 기본 태그: ${IMAGE_TAG}"
                                echo "   - 개발 태그: dev"
                                ;;
                            *)
                                echo "✅ 피처 브랜치 배포 완료"
                                echo "   - 기본 태그: ${IMAGE_TAG}"
                                ;;
                        esac

                        echo ""
                        echo "🎉 파이프라인 성공적으로 완료되었습니다!"
                    '''
                }

                failure {
                    echo "파이프라인 실패!"
                    sh '''
                        echo "=== 디버깅 정보 ==="
                        echo "실패한 브랜치: ${BRANCH_NAME_CLEAN}"
                        echo "시도한 이미지 태그: ${IMAGE_TAG}"
                        echo ""

                        echo "=== 네임스페이스 상태 ==="
                        /usr/local/bin/kubectl get namespaces | grep app || echo "app 네임스페이스 없음"

                        echo "=== Pod 상태 ==="
                        /usr/local/bin/kubectl get pods -n app || echo "app 네임스페이스의 Pod 없음"

                        echo "=== 실패한 Pod 로그 ==="
                        failed_pods=$(/usr/local/bin/kubectl get pods -n app --field-selector=status.phase!=Running -o name 2>/dev/null)
                        if [ -n "$failed_pods" ]; then
                            for pod in $failed_pods; do
                                echo "=== $pod 로그 ==="
                                /usr/local/bin/kubectl logs $pod -n app --tail=50 || echo "$pod 로그 조회 실패"
                            done
                        else
                            echo "실패한 Pod 없음"
                        fi

                        echo "=== 최근 이벤트 ==="
                        /usr/local/bin/kubectl get events -n app --sort-by='.lastTimestamp' | tail -10 || echo "이벤트 없음"

                        echo "=== Docker 상태 ==="
                        docker ps -a | head -10 || echo "Docker 정보 없음"

                        echo "=== 시스템 리소스 ==="
                        free -h || echo "메모리 정보 없음"
                        df -h | head -10 || echo "디스크 정보 없음"

                        echo "=== Rollout 실패 상태 ==="
                        /usr/local/bin/kubectl get rollouts -n app || echo "Rollout 없음"

                        echo "=== ECR 이미지 상태 확인 ==="
                        for service in auth-service user-service module-common; do
                            echo "=== $service 최근 이미지 ==="
                            /usr/local/bin/aws ecr describe-images --repository-name peopleofdelivery/$service --region ap-northeast-2 --query 'imageDetails[*].{Tags:imageTags,Pushed:imagePushedAt}' --output table 2>/dev/null | head -10 || echo "$service 이미지 조회 실패"
                        done

                        echo ""
                        echo "❌ 파이프라인이 실패했습니다. 위 로그를 확인해주세요."
                    '''
                }

                unstable {
                    echo "파이프라인 불안정 상태"
                    sh '''
                        echo "=== 불안정 상태 분석 ==="
                        /usr/local/bin/kubectl get pods -n app --field-selector=status.phase!=Running
                        /usr/local/bin/kubectl get rollouts -n app -o jsonpath='{.items[*].status.phase}'

                        echo "⚠️  파이프라인이 불안정한 상태입니다."
                    '''
                }

                always {
                    echo "파이프라인 정리 작업 시작"
                    sh '''
                        echo "=== 태그 생성 결과 요약 ==="
                        echo "브랜치: ${BRANCH_NAME_CLEAN}"
                        echo "기본 태그: ${IMAGE_TAG}"

                        # 생성된 태그들 확인
                        case "${BRANCH_NAME_CLEAN}" in
                            main|master)
                                echo "생성된 추가 태그: latest, canary-ready"
                                ;;
                            jenkins-canary|canary|*canary*)
                                echo "생성된 추가 태그: canary"
                                ;;
                            develop|dev)
                                echo "생성된 추가 태그: dev"
                                ;;
                            *)
                                echo "추가 태그: 없음 (기본 태그만)"
                                ;;
                        esac

                        echo "=== Docker 정리 ==="
                        # 빌드 캐시 정리 (디스크 공간 절약)
                        docker system prune -f || true

                        # 사용하지 않는 이미지 정리 (선택사항)
                        docker image prune -f || true

                        echo "=== 임시 파일 정리 ==="
                        # 워크스페이스의 임시 파일들 정리
                        find ${WORKSPACE} -name "*.tmp" -delete 2>/dev/null || true
                        find ${WORKSPACE} -name ".gradle" -type d -exec rm -rf {} + 2>/dev/null || true

                        echo "=== 최종 상태 ==="
                        echo "파이프라인 실행 시간: $(date)"
                        echo "빌드 번호: ${BUILD_NUMBER}"
                        echo "커밋 해시: ${GIT_COMMIT_SHORT}"

                        echo "정리 작업 완료"
                        echo "🔧 파이프라인 정리가 완료되었습니다."
                    '''
                }
            }
        }