pipeline {
    agent any
    
    environment {
        # 기본 빌드 설정
        IMAGE_TAG = "${BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "코드 체크아웃 중..."
                checkout scm
            }
        }
        
        stage('Load Environment Variables') {
            steps {
                echo "ConfigFile에서 환경변수 로드 중..."
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    script {
                        // ConfigFile Provider에서 환경변수 로드
                        def props = readProperties file: env.CONFIG_FILE
                        props.each { key, value ->
                            env[key] = value
                            echo "환경변수 설정: ${key} = ${value}"
                        }
                        
                        // ECR_REGISTRY 설정 (ConfigFile 로드 후)
                        env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                        echo "ECR_REGISTRY 설정: ${env.ECR_REGISTRY}"
                    }
                }
            }
        }
        
        stage('Build and Push Images') {
            parallel {
                stage('Build Auth Service') {
                    steps {
                        dir('auth-service') {
                            echo "Auth Service 빌드 중..."
                            // Gradle Wrapper가 없으면 생성
                            sh '''
                                if [ ! -f "./gradlew" ]; then
                                    echo "Gradle Wrapper가 없습니다. 생성 중..."
                                    # Gradle이 설치되어 있지 않으면 직접 다운로드
                                    if ! command -v gradle &> /dev/null; then
                                        echo "Gradle이 설치되어 있지 않습니다. 직접 설치 중..."
                                        curl -L -o gradle-8.13-bin.zip https://services.gradle.org/distributions/gradle-8.13-bin.zip
                                        unzip -q gradle-8.13-bin.zip
                                        export PATH=$PATH:$(pwd)/gradle-8.13/bin
                                        gradle wrapper --gradle-version=8.13
                                    else
                                        gradle wrapper --gradle-version=8.13
                                    fi
                                fi
                            '''
                            sh './gradlew clean build -x test'
                            
                            echo "Auth Service Docker 이미지 빌드 중..."
                            sh "docker build -t ${ECR_REGISTRY}/${ECR_PREFIX}/auth-service:${IMAGE_TAG} ."
                            
                            echo "Auth Service 이미지 ECR 푸시 중..."
                            sh "docker push ${ECR_REGISTRY}/${ECR_PREFIX}/auth-service:${IMAGE_TAG}"
                        }
                    }
                }
                
                stage('Build User Service') {
                    steps {
                        dir('user-service') {
                            echo " User Service 빌드 중..."
                            // Gradle Wrapper가 없으면 생성
                            sh '''
                                if [ ! -f "./gradlew" ]; then
                                    echo "Gradle Wrapper가 없습니다. 생성 중..."
                                    gradle wrapper --gradle-version=8.13
                                fi
                            '''
                            sh './gradlew clean build -x test'
                            
                            echo " User Service Docker 이미지 빌드 중..."
                            sh "docker build -t ${ECR_REGISTRY}/${ECR_PREFIX}/user-service:${IMAGE_TAG} ."
                            
                            echo " User Service 이미지 ECR 푸시 중..."
                            sh "docker push ${ECR_REGISTRY}/${ECR_PREFIX}/user-service:${IMAGE_TAG}"
                        }
                    }
                }
                
                stage('Build Module Common') {
                    steps {
                        dir('module-common') {
                            echo " Module Common 빌드 중..."
                            // Gradle Wrapper가 없으면 생성
                            sh '''
                                if [ ! -f "./gradlew" ]; then
                                    echo "Gradle Wrapper가 없습니다. 생성 중..."
                                    gradle wrapper --gradle-version=8.13
                                fi
                            '''
                            sh './gradlew clean build -x test'
                            
                            echo " Module Common Docker 이미지 빌드 중..."
                            sh "docker build -t ${ECR_REGISTRY}/${ECR_PREFIX}/module-common:${IMAGE_TAG} ."
                            
                            echo " Module Common 이미지 ECR 푸시 중..."
                            sh "docker push ${ECR_REGISTRY}/${ECR_PREFIX}/module-common:${IMAGE_TAG}"
                        }
                    }
                }
            }
        }
        
        stage('Deploy All Services (Single Config)') {
            steps {
                script {
                    echo " 모든 서비스 배포 시작"
                    
                    configFileProvider([
                        configFile(fileId: 'all-services', variable: 'ALL_CONFIG')
                    ]) {
                        sh '''
                            echo " 모든 서비스 설정 파일 로드 중..."
                            
                            # 모든 설정 로드
                            source $ALL_CONFIG
                            
                            echo " 설정 로드 완료"
                            echo " AWS Region: $AWS_REGION"
                            echo " Domain: $DOMAIN"
                            echo " DB URL: $DB_URL"
                            echo " Redis Host: $REDIS_HOST"
                            echo " Auth Service Port: $AUTH_SERVICE_PORT"
                            echo " User Service Port: $USER_SERVICE_PORT"
                            echo " Module Common Port: $MODULE_COMMON_SERVICE_PORT"
                            echo " 비밀 설정들은 안전하게 로드됨"
                            
                            # ========================================
                            # Auth Service ConfigMap 및 Secret 생성
                            # ========================================
                            echo " Auth Service ConfigMap 생성 중..."
                            kubectl create configmap auth-service-config -n app \
                                --from-literal=db-url="$DB_URL" \
                                --from-literal=db-username="$DB_USERNAME" \
                                --from-literal=redis-host="$REDIS_HOST" \
                                --from-literal=redis-port="$REDIS_PORT" \
                                --from-literal=google-client-id="$GOOGLE_CLIENT_ID" \
                                --from-literal=mail-username="$MAIL_USERNAME" \
                                --from-literal=service-port="$AUTH_SERVICE_PORT" \
                                --from-literal=health-check-path="$AUTH_SERVICE_HEALTH_CHECK_PATH" \
                                --dry-run=client -o yaml | kubectl apply -f -
                            
                            echo " Auth Service Secret 생성 중..."
                            kubectl create secret generic auth-service-secrets -n app \
                                --from-literal=db-password="$DB_PASSWORD" \
                                --from-literal=google-client-secret-id="$GOOGLE_CLIENT_SECRET_ID" \
                                --from-literal=mail-password="$MAIL_PASSWORD" \
                                --from-literal=jwt-secret="$JWT_SECRET" \
                                --from-literal=jwt-refresh-secret="$JWT_REFRESH_SECRET" \
                                --from-literal=passport-secret="$AUTH_SERVICE_PASSPORT_SECRET" \
                                --from-literal=redis-password="$REDIS_PASSWORD" \
                                --dry-run=client -o yaml | kubectl apply -f -
                            
                            # ========================================
                            # User Service ConfigMap 및 Secret 생성
                            # ========================================
                            echo " User Service ConfigMap 생성 중..."
                            kubectl create configmap user-service-config -n app \
                                --from-literal=db-url="$DB_URL" \
                                --from-literal=db-username="$DB_USERNAME" \
                                --from-literal=redis-host="$REDIS_HOST" \
                                --from-literal=redis-port="$REDIS_PORT" \
                                --from-literal=google-client-id="$GOOGLE_CLIENT_ID" \
                                --from-literal=mail-username="$MAIL_USERNAME" \
                                --from-literal=service-port="$USER_SERVICE_PORT" \
                                --from-literal=health-check-path="$USER_SERVICE_HEALTH_CHECK_PATH" \
                                --dry-run=client -o yaml | kubectl apply -f -
                            
                            echo " User Service Secret 생성 중..."
                            kubectl create secret generic user-service-secrets -n app \
                                --from-literal=db-password="$DB_PASSWORD" \
                                --from-literal=google-client-secret-id="$GOOGLE_CLIENT_SECRET_ID" \
                                --from-literal=mail-password="$MAIL_PASSWORD" \
                                --from-literal=jwt-secret="$JWT_SECRET" \
                                --from-literal=jwt-refresh-secret="$JWT_REFRESH_SECRET" \
                                --from-literal=passport-secret="$USER_SERVICE_PASSPORT_SECRET" \
                                --from-literal=redis-password="$REDIS_PASSWORD" \
                                --dry-run=client -o yaml | kubectl apply -f -
                            
                            # ========================================
                            # Module Common ConfigMap 및 Secret 생성
                            # ========================================
                            echo " Module Common ConfigMap 생성 중..."
                            kubectl create configmap module-common-config -n app \
                                --from-literal=db-url="$DB_URL" \
                                --from-literal=db-username="$DB_USERNAME" \
                                --from-literal=service-port="$MODULE_COMMON_SERVICE_PORT" \
                                --from-literal=health-check-path="$MODULE_COMMON_SERVICE_HEALTH_CHECK_PATH" \
                                --dry-run=client -o yaml | kubectl apply -f -
                            
                            echo " Module Common Secret 생성 중..."
                            kubectl create secret generic module-common-secrets -n app \
                                --from-literal=db-password="$DB_PASSWORD" \
                                --dry-run=client -o yaml | kubectl apply -f -
                            
                            echo " 모든 ConfigMap 및 Secret 생성 완료!"
                            
                            # ========================================
                            # Argo Rollouts 배포
                            # ========================================
                            echo " Auth Service 카나리 배포 시작..."
                            kubectl argo rollouts set image auth-service-rollout -n app \
                                auth-service=${ECR_REGISTRY}/${ECR_PREFIX}/auth-service:${IMAGE_TAG}
                            kubectl argo rollouts promote auth-service-rollout -n app
                            
                            echo " User Service 카나리 배포 시작..."
                            kubectl argo rollouts set image user-service-rollout -n app \
                                user-service=${ECR_REGISTRY}/${ECR_PREFIX}/user-service:${IMAGE_TAG}
                            kubectl argo rollouts promote user-service-rollout -n app
                            
                            echo " Module Common 카나리 배포 시작..."
                            kubectl argo rollouts set image module-common-rollout -n app \
                                module-common=${ECR_REGISTRY}/${ECR_PREFIX}/module-common:${IMAGE_TAG}
                            kubectl argo rollouts promote module-common-rollout -n app
                            
                            echo " 모든 서비스 카나리 배포 시작 완료!"
                        '''
                    }
                }
            }
        }
        
        stage('Monitor Canary Progress') {
            steps {
                script {
                    echo "📊 카나리 배포 진행 상황 모니터링 중..."
                    
                    sh '''
                        echo " Auth Service 롤아웃 상태 확인..."
                        kubectl argo rollouts get rollout auth-service-rollout -n app
                        
                        echo " User Service 롤아웃 상태 확인..."
                        kubectl argo rollouts get rollout user-service-rollout -n app
                        
                        echo " Module Common 롤아웃 상태 확인..."
                        kubectl argo rollouts get rollout module-common-rollout -n app
                        
                        echo " 20분 대기 중... (카나리 배포 진행)"
                        sleep 1200
                        
                        echo " 카나리 배포 모니터링 완료!"
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo " 모든 서비스 배포 성공!"
        }
        failure {
            echo " 배포 실패! 롤백을 고려하세요."
        }
    }
}
