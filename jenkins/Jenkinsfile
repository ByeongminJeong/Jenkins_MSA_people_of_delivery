pipeline {
    agent any
    
    environment {
        // Git 커밋 해시를 포함한 의미있는 태그 생성
        GIT_COMMIT_SHORT = sh(
            script: 'git rev-parse --short HEAD',
            returnStdout: true
        ).trim()

        // 브랜치명 정리 및 안전한 태그 생성
        BRANCH_NAME_CLEAN = sh(
            script: '''
                if [ -n "${BRANCH_NAME}" ]; then
                    # 브랜치명에서 특수문자를 대시로 변경하고 앞뒤 대시 제거
                    echo "${BRANCH_NAME}" | sed 's/[^a-zA-Z0-9]/-/g' | sed 's/^-*//' | sed 's/-*$//'
                else
                    echo "main"
                fi
            ''',
            returnStdout: true
        ).trim()

        // 안전한 이미지 태그 생성: 브랜치명-커밋해시 또는 build-빌드번호
        IMAGE_TAG = sh(
            script: '''
                CLEAN_BRANCH="${BRANCH_NAME_CLEAN:-main}"
                COMMIT_SHORT="${GIT_COMMIT_SHORT}"

                # 태그 유효성 검사
                if [ -n "$CLEAN_BRANCH" ] && [ -n "$COMMIT_SHORT" ]; then
                    TAG="${CLEAN_BRANCH}-${COMMIT_SHORT}"
                else
                    TAG="build-${BUILD_NUMBER}"
                fi

                # 태그가 하이픈으로 시작하지 않도록 보장
                echo "$TAG" | sed 's/^-*//'
            ''',
            returnStdout: true
        ).trim()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "코드 체크아웃 중..."
                checkout scm
            }
        }
        
        stage('Load Configuration') {
            steps {
                echo "환경 설정 로드 중..."
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        echo "설정 파일 로드 완료: $CONFIG_FILE"
                        
                        # 설정 파일 내용 로드
                        . $CONFIG_FILE
                        
                        # 주요 설정값들 확인 (비밀번호 제외)
                        echo "AWS Region: $AWS_REGION"
                        echo "AWS Account ID: $AWS_ACCOUNT_ID"
                        echo "ECR Prefix: $ECR_PREFIX"
                        echo "Auth Service Port: $AUTH_SERVICE_PORT"
                        echo "User Service Port: $USER_SERVICE_PORT"
                        echo "Module Common Port: $MODULE_COMMON_SERVICE_PORT"
                        echo "DB URL: $DB_URL"
                        echo "Redis Host: $REDIS_HOST"
                        
                        # AWS 설정
                        /usr/local/bin/aws configure set aws_access_key_id $AWS_ACCESS_KEY_ID
                        /usr/local/bin/aws configure set aws_secret_access_key $AWS_SECRET_ACCESS_KEY
                        /usr/local/bin/aws configure set default.region $AWS_REGION
                        
                        echo "AWS 설정 완료"
                        /usr/local/bin/aws sts get-caller-identity
                    '''
                }
            }
        }
        
        stage('Start Docker Daemon') {
            steps {
                echo "Docker 데몬 시작 중..."
                sh '''
                    # Docker 데몬 시작
                    dockerd --host=unix:///var/run/docker.sock --host=tcp://0.0.0.0:2376 &
                    
                    # Docker 데몬이 완전히 시작될 때까지 대기
                    echo "Docker 데몬 시작 대기 중..."
                    sleep 30
                    
                    # Docker 상태 확인 (재시도 로직)
                    echo "Docker 데몬 상태 확인..."
                    for i in {1..10}; do
                        if docker version >/dev/null 2>&1; then
                            echo "Docker 데몬 연결 성공!"
                            break
                        else
                            echo "Docker 데몬 연결 시도 $i/10..."
                            sleep 5
                        fi
                    done
                    
                    # 최종 확인
                    docker version
                    docker ps
                    echo "Docker 데몬 시작 완료"
                '''
            }
        }
        
        stage('ECR Login') {
            steps {
                echo "ECR 로그인 중..."
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        . $CONFIG_FILE
                        
                        export ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                        echo "ECR Registry: $ECR_REGISTRY"
                        
                        /usr/local/bin/aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY
                        echo "ECR 로그인 성공"
                    '''
                }
            }
        }
        
        stage('Build and Push Images') {
            parallel {
                stage('Build Auth Service') {
                    steps {
                        script {
                            try {
                                echo "Auth Service 빌드 중..."
                                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                                    sh '''
                                        # 설정 파일 로드
                                        . $CONFIG_FILE

                                        # 환경변수 명시적 설정 및 확인
                                        export ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                                        export IMAGE_TAG_VAR="'''+IMAGE_TAG+'''"

                                        # 디버깅을 위한 환경변수 출력
                                        echo "=== Auth Service 환경변수 확인 ==="
                                        echo "ECR_REGISTRY: ${ECR_REGISTRY}"
                                        echo "ECR_PREFIX: ${ECR_PREFIX}"
                                        echo "IMAGE_TAG: ${IMAGE_TAG_VAR}"
                                        echo "현재 작업 디렉터리: $(pwd)"
                                        echo "================================"

                                        # 루트 디렉터리로 명시적 이동
                                        cd "${WORKSPACE}"
                                        echo "루트 디렉토리로 이동: $(pwd)"
                                        echo "루트 디렉토리 파일들: $(ls -la | head -10)"

                                        # Gradle wrapper 존재 확인
                                        if [ -f "./gradlew" ]; then
                                            chmod +x ./gradlew
                                            echo "Auth Service Gradle 빌드 시작..."
                                            ./gradlew :auth-service:clean :auth-service:build -x test --no-daemon --stacktrace
                                        else
                                            echo "ERROR: Gradle wrapper not found in root directory"
                                            echo "Available files: $(ls -la)"
                                            exit 1
                                        fi

                                        echo "Auth Service Docker 이미지 빌드..."
                                        docker build -f ./auth-service/Dockerfile -t ${ECR_REGISTRY}/${ECR_PREFIX}/auth-service:${IMAGE_TAG_VAR} .

                                        echo "Auth Service ECR 푸시..."
                                        docker push ${ECR_REGISTRY}/${ECR_PREFIX}/auth-service:${IMAGE_TAG_VAR}

                                        echo "Auth Service 완료"
                                    '''
                                }
                            } catch (Exception e) {
                                echo "Auth Service 빌드 실패: ${e.getMessage()}"
                                echo "하지만 다른 서비스는 계속 진행합니다."
                                currentBuild.result = 'UNSTABLE'
                            }
                        }
                    }
                }
                
                stage('Build User Service') {
                    steps {
                        script {
                            try {
                                echo "User Service 빌드 중..."
                                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                                    sh '''
                                        # 설정 파일 로드
                                        . $CONFIG_FILE

                                        # 환경변수 명시적 설정 및 확인
                                        export ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                                        export IMAGE_TAG_VAR="'''+IMAGE_TAG+'''"

                                        # 디버깅을 위한 환경변수 출력
                                        echo "=== User Service 환경변수 확인 ==="
                                        echo "ECR_REGISTRY: ${ECR_REGISTRY}"
                                        echo "ECR_PREFIX: ${ECR_PREFIX}"
                                        echo "IMAGE_TAG: ${IMAGE_TAG_VAR}"
                                        echo "현재 작업 디렉터리: $(pwd)"
                                        echo "================================"

                                        # 루트 디렉터리로 명시적 이동
                                        cd "${WORKSPACE}"
                                        echo "루트 디렉토리로 이동: $(pwd)"

                                        # Gradle wrapper 존재 확인 및 User Service 빌드
                                        if [ -f "./gradlew" ]; then
                                            chmod +x ./gradlew
                                            echo "User Service Gradle 빌드 시작..."
                                            ./gradlew :user-service:clean :user-service:build -x test --no-daemon --stacktrace
                                        else
                                            echo "ERROR: Gradle wrapper not found in root directory"
                                            exit 1
                                        fi

                                        echo "User Service Docker 이미지 빌드..."
                                        docker build -f ./user-service/Dockerfile -t ${ECR_REGISTRY}/${ECR_PREFIX}/user-service:${IMAGE_TAG_VAR} .

                                        echo "User Service ECR 푸시..."
                                        docker push ${ECR_REGISTRY}/${ECR_PREFIX}/user-service:${IMAGE_TAG_VAR}

                                        echo "User Service 완료"
                                    '''
                                }
                            } catch (Exception e) {
                                echo "User Service 빌드 실패: ${e.getMessage()}"
                                echo "하지만 다른 서비스는 계속 진행합니다."
                                currentBuild.result = 'UNSTABLE'
                            }
                        }
                    }
                }
                
                stage('Build Module Common') {
                    steps {
                        script {
                            try {
                                echo "Module Common 빌드 중..."
                                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                                    sh '''
                                        # 설정 파일 로드
                                        . $CONFIG_FILE

                                        # 환경변수 명시적 설정 및 확인
                                        export ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                                        export IMAGE_TAG_VAR="'''+IMAGE_TAG+'''"

                                        # 디버깅을 위한 환경변수 출력
                                        echo "=== Module Common 환경변수 확인 ==="
                                        echo "ECR_REGISTRY: ${ECR_REGISTRY}"
                                        echo "ECR_PREFIX: ${ECR_PREFIX}"
                                        echo "IMAGE_TAG: ${IMAGE_TAG_VAR}"
                                        echo "현재 작업 디렉터리: $(pwd)"
                                        echo "===================================="

                                        # 루트 디렉터리로 명시적 이동
                                        cd "${WORKSPACE}"
                                        echo "루트 디렉토리로 이동: $(pwd)"

                                        # Gradle wrapper 존재 확인 및 Module Common 빌드
                                        if [ -f "./gradlew" ]; then
                                            chmod +x ./gradlew
                                            echo "Module Common Gradle 빌드 시작..."
                                            ./gradlew :module-common:clean :module-common:build -x test --no-daemon --stacktrace
                                        else
                                            echo "ERROR: Gradle wrapper not found in root directory"
                                            exit 1
                                        fi

                                        echo "Module Common Docker 이미지 빌드..."
                                        docker build -f ./module-common/Dockerfile -t ${ECR_REGISTRY}/${ECR_PREFIX}/module-common:${IMAGE_TAG_VAR} .

                                        echo "Module Common ECR 푸시..."
                                        docker push ${ECR_REGISTRY}/${ECR_PREFIX}/module-common:${IMAGE_TAG_VAR}

                                        echo "Module Common 완료"
                                    '''
                                }
                            } catch (Exception e) {
                                echo "Module Common 빌드 실패: ${e.getMessage()}"
                                echo "하지만 다른 서비스는 계속 진행합니다."
                                currentBuild.result = 'UNSTABLE'
                            }
                        }
                    }
                }
            }
        }
        
        stage('Deploy Services') {
            steps {
                echo "서비스 배포 시작"
                configFileProvider([configFile(fileId: 'all-services', variable: 'CONFIG_FILE')]) {
                    sh '''
                        . $CONFIG_FILE
                        export ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                        
                        echo "배포 시작..."
                        echo "ECR Registry: $ECR_REGISTRY"
                        echo "Image Tag: $IMAGE_TAG"
                        
                        # app 네임스페이스 생성
                        /usr/local/bin/kubectl create namespace app --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -
                        
                        # Auth Service ConfigMap
                        /usr/local/bin/kubectl create configmap auth-service-config -n app \
                            --from-literal=db-url="$DB_URL" \
                            --from-literal=db-username="$DB_USERNAME" \
                            --from-literal=redis-host="$REDIS_HOST" \
                            --from-literal=redis-port="$REDIS_PORT" \
                            --from-literal=google-client-id="$GOOGLE_CLIENT_ID" \
                            --from-literal=mail-username="$MAIL_USERNAME" \
                            --from-literal=service-port="$AUTH_SERVICE_PORT" \
                            --from-literal=health-check-path="$AUTH_SERVICE_HEALTH_CHECK_PATH" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -
                        
                        # Auth Service Secret
                        /usr/local/bin/kubectl create secret generic auth-service-secrets -n app \
                            --from-literal=db-password="$DB_PASSWORD" \
                            --from-literal=google-client-secret-id="$GOOGLE_CLIENT_SECRET_ID" \
                            --from-literal=mail-password="$MAIL_PASSWORD" \
                            --from-literal=jwt-secret="$JWT_SECRET" \
                            --from-literal=jwt-refresh-secret="$JWT_REFRESH_SECRET" \
                            --from-literal=passport-secret="$AUTH_SERVICE_PASSPORT_SECRET" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -
                        
                        # User Service ConfigMap
                        /usr/local/bin/kubectl create configmap user-service-config -n app \
                            --from-literal=db-url="$DB_URL" \
                            --from-literal=db-username="$DB_USERNAME" \
                            --from-literal=redis-host="$REDIS_HOST" \
                            --from-literal=redis-port="$REDIS_PORT" \
                            --from-literal=google-client-id="$GOOGLE_CLIENT_ID" \
                            --from-literal=mail-username="$MAIL_USERNAME" \
                            --from-literal=service-port="$USER_SERVICE_PORT" \
                            --from-literal=health-check-path="$USER_SERVICE_HEALTH_CHECK_PATH" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -
                        
                        # User Service Secret
                        /usr/local/bin/kubectl create secret generic user-service-secrets -n app \
                            --from-literal=db-password="$DB_PASSWORD" \
                            --from-literal=google-client-secret-id="$GOOGLE_CLIENT_SECRET_ID" \
                            --from-literal=mail-password="$MAIL_PASSWORD" \
                            --from-literal=jwt-secret="$JWT_SECRET" \
                            --from-literal=jwt-refresh-secret="$JWT_REFRESH_SECRET" \
                            --from-literal=passport-secret="$USER_SERVICE_PASSPORT_SECRET" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -
                        
                        # Module Common ConfigMap
                        /usr/local/bin/kubectl create configmap module-common-config -n app \
                            --from-literal=db-url="$DB_URL" \
                            --from-literal=db-username="$DB_USERNAME" \
                            --from-literal=service-port="$MODULE_COMMON_SERVICE_PORT" \
                            --from-literal=health-check-path="$MODULE_COMMON_SERVICE_HEALTH_CHECK_PATH" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -
                        
                        # Module Common Secret
                        /usr/local/bin/kubectl create secret generic module-common-secrets -n app \
                            --from-literal=db-password="$DB_PASSWORD" \
                            --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -
                        
                        echo "ConfigMap 및 Secret 생성 완료"
                        
                        # Argo Rollouts 배포 - envsubst를 사용하여 환경변수 치환
                        if /usr/local/bin/kubectl get crd rollouts.argoproj.io >/dev/null 2>&1; then
                            echo "Argo Rollouts 배포 시작..."
                            echo "환경변수 확인:"
                            echo "ECR_REGISTRY: $ECR_REGISTRY"
                            echo "ECR_PREFIX: $ECR_PREFIX"
                            echo "IMAGE_TAG: $IMAGE_TAG"

                            # 환경변수 확인 및 export
                            echo "환경변수 확인:"
                            echo "ECR_REGISTRY: $ECR_REGISTRY"
                            echo "ECR_PREFIX: $ECR_PREFIX"
                            echo "IMAGE_TAG: $IMAGE_TAG"

                            # 환경변수 올바르게 export
                            export ECR_REGISTRY="$ECR_REGISTRY"
                            export ECR_PREFIX="$ECR_PREFIX"
                            export IMAGE_TAG="$IMAGE_TAG"
                            
                            # envsubst가 인식할 수 있도록 환경변수 재설정
                            ECR_REGISTRY="$ECR_REGISTRY"
                            ECR_PREFIX="$ECR_PREFIX"
                            IMAGE_TAG="$IMAGE_TAG"

                            # Auth Service Rollout 배포
                            if [ -f "k8s/services/auth-service/auth-service-rollout.yaml" ]; then
                                echo "Auth Service Rollout 배포 중..."
                                envsubst '$ECR_REGISTRY $ECR_PREFIX $IMAGE_TAG' < k8s/services/auth-service/auth-service-rollout.yaml | /usr/local/bin/kubectl apply -f -
                                echo "Auth Service Rollout 배포 완료"
                            else
                                echo "Auth Service Rollout 파일 없음"
                            fi
                            
                            # User Service Rollout 배포
                            if [ -f "k8s/services/user-service/user-service-rollout.yaml" ]; then
                                echo "User Service Rollout 배포 중..."
                                envsubst '$ECR_REGISTRY $ECR_PREFIX $IMAGE_TAG' < k8s/services/user-service/user-service-rollout.yaml | /usr/local/bin/kubectl apply -f -
                                echo "User Service Rollout 배포 완료"
                            else
                                echo "User Service Rollout 파일 없음"
                            fi
                            
                            # Module Common Rollout 배포
                            if [ -f "k8s/services/module-common/module-common-rollout.yaml" ]; then
                                echo "Module Common Rollout 배포 중..."
                                envsubst '$ECR_REGISTRY $ECR_PREFIX $IMAGE_TAG' < k8s/services/module-common/module-common-rollout.yaml | /usr/local/bin/kubectl apply -f -
                                echo "Module Common Rollout 배포 완료"
                            else
                                echo "Module Common Rollout 파일 없음"
                            fi

                            # Rollout 상태 확인
                            echo "Rollout 상태 확인 중..."
                            sleep 10
                            /usr/local/bin/kubectl get rollouts -n app || echo "Rollout 없음"

                        else
                            echo "Argo Rollouts 미설치"
                        fi
                        
                        echo "배포 완료"
                    '''
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                echo "배포 상태 확인 중..."
                sh '''
                    echo "=== 배포 상태 확인 ==="
                    /usr/local/bin/kubectl get all -n app
                    
                    echo "=== ConfigMap 확인 ==="
                    /usr/local/bin/kubectl get configmaps -n app
                    
                    echo "=== Secret 확인 ==="
                    /usr/local/bin/kubectl get secrets -n app
                    
                    echo "=== Rollout 확인 ==="
                    if /usr/local/bin/kubectl get crd rollouts.argoproj.io >/dev/null 2>&1; then
                        /usr/local/bin/kubectl get rollouts -n app || echo "Rollout 없음"
                        
                        # 각 Rollout 상태 확인
                        if /usr/local/bin/kubectl get rollout auth-service-rollout -n app >/dev/null 2>&1; then
                            echo "Auth Service Rollout 상태:"
                            /usr/local/bin/kubectl argo rollouts get rollout auth-service-rollout -n app
                        fi
                        
                        if /usr/local/bin/kubectl get rollout user-service-rollout -n app >/dev/null 2>&1; then
                            echo "User Service Rollout 상태:"
                            /usr/local/bin/kubectl argo rollouts get rollout user-service-rollout -n app
                        fi
                    else
                        echo "Argo Rollouts 미설치"
                    fi
                    
                    echo "=== 배포 확인 완료 ==="
                '''
            }
        }
    }
    
    post {
        success {
            echo "전체 파이프라인 성공!"
            sh '''
                echo "=== 최종 배포 결과 ==="
                /usr/local/bin/kubectl get pods -n app
                echo "=== 이미지 확인 ==="
                /usr/local/bin/kubectl get pods -n app -o jsonpath="{.items[*].spec.containers[*].image}" | tr " " "\\n" | sort | uniq
            '''
        }
        failure {
            echo "파이프라인 실패!"
            sh '''
                echo "=== 디버깅 정보 ==="
                /usr/local/bin/kubectl get all -n app || echo "app 네임스페이스 없음"
                /usr/local/bin/kubectl get events -n app --sort-by='.lastTimestamp' | tail -10 || echo "이벤트 없음"
            '''
        }
        always {
            echo "파이프라인 정리 완료"
        }
    }
}