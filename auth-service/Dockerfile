FROM eclipse-temurin:21-jdk-jammy AS builder
WORKDIR /app

COPY gradlew ./gradlew
COPY gradle ./gradle
COPY build.gradle settings.gradle ./
COPY module-common/ ./module-common
COPY auth-service/ ./auth-service

RUN ./gradlew :auth-service:bootJar --no-daemon --build-cache

# 실행 단계
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

# 환경 변수 설정
ARG DB_URL
ARG DB_USERNAME
ARG DB_PASSWORD
ARG REDIS_HOST
ARG REDIS_PORT
ARG REDIS_PASSWORD
ARG JWT_SECRET
ARG JWT_REFRESH_SECRET
ARG GOOGLE_CLIENT_ID
ARG GOOGLE_CLIENT_SECRET_ID
ARG MAIL_USERNAME
ARG MAIL_PASSWORD
ARG TOSS_CLIENT
ARG TOSS_SECRET
ARG GEMINI_API_KEY
ARG WEATHER_API_KEY
ARG MONGO_URI
ARG COGNITO_USER_POOL_ID
ARG COGNITO_CLIENT_ID

# 환경 변수를 런타임 환경 변수로 설정
ENV SPRING_DATASOURCE_URL=${DB_URL}
ENV SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
ENV SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}
ENV REDIS_HOST=${REDIS_HOST}
ENV REDIS_PORT=${REDIS_PORT}
ENV REDIS_PASSWORD=${REDIS_PASSWORD}
ENV JWT_SECRET=${JWT_SECRET}
ENV JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
ENV GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
ENV GOOGLE_CLIENT_SECRET_ID=${GOOGLE_CLIENT_SECRET_ID}
ENV MAIL_USERNAME=${MAIL_USERNAME}
ENV MAIL_PASSWORD=${MAIL_PASSWORD}
ENV TOSS_CLIENT=${TOSS_CLIENT}
ENV TOSS_SECRET=${TOSS_SECRET}
ENV GEMINI_API_KEY=${GEMINI_API_KEY}
ENV WEATHER_API_KEY=${WEATHER_API_KEY}
ENV MONGO_URI=${MONGO_URI}
ENV COGNITO_USER_POOL_ID=${COGNITO_USER_POOL_ID}
ENV COGNITO_CLIENT_ID=${COGNITO_CLIENT_ID}

COPY --from=builder /app/auth-service/build/libs/*.jar app.jar
EXPOSE 8015
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
